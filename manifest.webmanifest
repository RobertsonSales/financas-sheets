{
  "name": "Finanças Plus · Receitas e Despesas",
  "short_name": "Finanças Plus",
  "description": "Dashboard de receitas e despesas sincronizado com Google Sheets.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
